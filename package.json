{
    "name":  "headquarters",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Headquarters - professional operating environment for disciplined trading execution.",
    "packageManager":  "pnpm@9.0.0",
    "scripts":  {
                    "dev":  "corepack pnpm --filter @headquarters/desktop dev",
                    "build":  "corepack pnpm -r build",
                    "typecheck":  "corepack pnpm -r typecheck",
                    "lint":  "eslint .",
                    "test":  "vitest run --passWithNoTests",
                    "db:migrate":  "corepack pnpm --filter @headquarters/database migrate"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.17.0",
                            "@types/node":  "^22.10.2",
                            "eslint":  "^9.17.0",
                            "globals":  "^15.14.0",
                            "typescript":  "^5.6.3",
                            "typescript-eslint":  "^8.18.2",
                            "turbo":  "^2.2.3",
                            "vitest":  "^2.1.8"
                        }
}
