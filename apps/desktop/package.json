{
  "name": "@headquarters/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "pnpm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron dist/main/main.js\"",
    "build:main": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src vite.config.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@headquarters/shared": "workspace:*",
    "@headquarters/hqos": "workspace:*",
    "@headquarters/ui": "workspace:*",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.1",
    "vite": "^5.4.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
