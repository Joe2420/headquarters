{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@headquarters/shared": ["packages/shared/src/index.ts"],
      "@headquarters/hqos": ["packages/hqos/src/index.ts"],
      "@headquarters/journal": ["packages/journal/src/index.ts"],
      "@headquarters/doctrine": ["packages/doctrine/src/index.ts"],
      "@headquarters/academy": ["packages/academy/src/index.ts"],
      "@headquarters/commander": ["packages/commander/src/index.ts"],
      "@headquarters/intelligence-office": ["packages/intelligence-office/src/index.ts"],
      "@headquarters/archive-intelligence": ["packages/archive-intelligence/src/index.ts"],
      "@headquarters/guardian": ["packages/guardian/src/index.ts"],
      "@headquarters/database": ["packages/database/src/index.ts"],
      "@headquarters/ai-runtime": ["packages/ai-runtime/src/index.ts"],
      "@headquarters/ui": ["packages/ui/src/index.ts"],
      "@headquarters/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@headquarters/assets": ["packages/assets/src/index.ts"],
      "@headquarters/testing": ["packages/testing/src/index.ts"],
      "@headquarters/config": ["packages/config/src/index.ts"]
    }
  }
}
